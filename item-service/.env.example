# Configuration de la base de données MySQL (XAMPP local)
# Format : mysql+pymysql://utilisateur:mot_de_passe@hote:port/nom_base
DATABASE_URL=mysql+pymysql://root:@localhost:3306/item_db

# Configuration du bus d'événements RabbitMQ (CloudAMQP)
RABBITMQ_URL=amqps://username:password@hostname/vhost
RABBITMQ_EXCHANGE=smartlostfound.exchange
RABBITMQ_ITEM_ROUTING_KEY=item.created
