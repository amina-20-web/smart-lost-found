# ════════════════════════════════════════════════════════════════
#  .env.example — Variables d'environnement Docker Compose
#
#  Instructions :
#    1. Copiez ce fichier : cp .env.example .env
#    2. Modifiez les valeurs selon votre environnement
#    3. Ne commitez JAMAIS le fichier .env sur Git
# ════════════════════════════════════════════════════════════════

# ── MySQL ──────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=smart_lost_found_notifications
MYSQL_USER=slf_user
MYSQL_PASSWORD=slf_password
MYSQL_PORT=3306

# ── RabbitMQ local (conteneur Docker) ─────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ── Pour utiliser CloudAMQP en PRODUCTION, remplacez par : ────
# RABBITMQ_HOST=rat.rmq2.cloudamqp.com
# RABBITMQ_USER=ibyocwfh
# RABBITMQ_PASSWORD=<votre_mot_de_passe_cloudamqp>
# RABBITMQ_VHOST=ibyocwfh
# RABBITMQ_AMQP_PORT=5671   (port TLS)
# (et activez SPRING_RABBITMQ_SSL_ENABLED=true dans docker-compose.yml)

# ── Ports des services ─────────────────────────────────────────
NOTIFICATION_SERVICE_PORT=8083
API_GATEWAY_PORT=8080
FRONTEND_PORT=3000
